<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTHETIC fixture — relabeled by re-audit finding N7.

  This file is NOT a real ioreg capture, and the previous header's claim
  that its values were transcribed from a real "macOS 27.2" machine was
  wrong and is retracted. The sandbox has no Mac, so `ioreg -r -n
  AppleSmartBattery -d 1 -a -x` could not be captured here. Nothing in
  this repository verifies real-hardware behavior; the platform
  collectors remain fixture-tested only.

  The KEY LAYOUT mirrors what real Apple-silicon macOS emits as described
  in re-audit finding N7 (observed on a MacBook Air M4, macOS 26.6.2):
  Temperature present at top level, capacity and cycle data via
  NominalChargeCapacity / DesignCapacity / DesignCycleCount9C (there is
  no CycleLimit key on that machine), NO top-level FullChargeCapacity,
  and a BatteryData child dict carrying nested copies of the firmware
  values. The parser must read from either level.

  The numeric values are synthetic and kept from the earlier fixture
  version. The scenario this synthetic encodes is deliberate and still
  valid: IsCharging reads Yes while the pack is net DISCHARGING (-1415
  mA, AvgTimeToEmpty 87 min) under a weak adapter. The power sign must
  come from the Amperage data, not from the IsCharging flag — this
  fixture locks that in. The previous header's claim that "the real
  machine had NO Temperature key" is retracted: per re-audit N7 the
  measured machine emits Temperature, and this fixture carries it.
-->
<plist version="1.0">
<array>
  <dict>
    <key>Voltage</key><integer>11509</integer>
    <key>Amperage</key><integer>-1415</integer>
    <key>CurrentCapacity</key><integer>57</integer>
    <key>Temperature</key><integer>3010</integer>
    <key>DesignCapacity</key><integer>4629</integer>
    <key>NominalChargeCapacity</key><integer>3925</integer>
    <key>DesignCycleCount9C</key><integer>1000</integer>
    <key>CycleCount</key><integer>628</integer>
    <key>AvgTimeToEmpty</key><integer>87</integer>
    <key>ExternalConnected</key><true/>
    <key>IsCharging</key><true/>
    <key>FullyCharged</key><false/>
    <key>BatteryData</key>
    <dict>
      <key>DesignCapacity</key><integer>4629</integer>
      <key>NominalChargeCapacity</key><integer>3925</integer>
      <key>DesignCycleCount9C</key><integer>1000</integer>
    </dict>
  </dict>
</array>
</plist>
